# Advanced Website Checker API Configuration
# Copy this file to .env and add your actual API keys

# Google Safe Browsing API
# Get your key at: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# VirusTotal API
# Get your key at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# URLVoid API
# Get your key at: http://www.urlvoid.com/
URLVOID_API_KEY=your_urlvoid_api_key_here

# Alternative: WHOIS API (for domain age checking)
# Get your key at: https://whoisjson.com/
WHOIS_API_KEY=your_whois_api_key_here
